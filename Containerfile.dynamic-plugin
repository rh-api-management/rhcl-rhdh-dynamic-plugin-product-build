FROM registry.redhat.io/ubi9/nodejs-22:latest AS builder

ARG YARNPKG_CLI=yarnpkg-cli-dist-4.12.0.tgz

USER root

# Install Yarn V4 — from cachi2 in hermetic mode, or corepack for local dev
WORKDIR /src/yarn
COPY yarn-install .

RUN if [[ -d /cachi2/output/deps/npm/ ]]; then \
      npm install -g /cachi2/output/deps/npm/"$YARNPKG_CLI"; \
    else \
      npm install -g corepack; \
      corepack enable; \
      corepack prepare yarn@4.12.0 --activate; \
    fi

RUN echo "node: $(node --version), yarn: $(yarn --version)"

WORKDIR /usr/src/app

# Copy lock + manifests first for layer caching
COPY kuadrant-backstage-plugin/package.json kuadrant-backstage-plugin/yarn.lock ./
# Workspace manifests — packages/*
COPY kuadrant-backstage-plugin/packages/app/package.json ./packages/app/package.json
COPY kuadrant-backstage-plugin/packages/app-next/package.json ./packages/app-next/package.json
COPY kuadrant-backstage-plugin/packages/backend/package.json ./packages/backend/package.json
COPY kuadrant-backstage-plugin/packages/plugin-utils/package.json ./packages/plugin-utils/package.json
COPY kuadrant-backstage-plugin/packages/theme-wrapper/package.json ./packages/theme-wrapper/package.json
# Workspace manifests — plugins/*
COPY kuadrant-backstage-plugin/plugins/kuadrant/package.json ./plugins/kuadrant/package.json
COPY kuadrant-backstage-plugin/plugins/kuadrant-backend/package.json ./plugins/kuadrant-backend/package.json
COPY kuadrant-backstage-plugin/plugins/dynamic-plugins-info-backend/package.json ./plugins/dynamic-plugins-info-backend/package.json
COPY kuadrant-backstage-plugin/plugins/licensed-users-info-backend/package.json ./plugins/licensed-users-info-backend/package.json
COPY kuadrant-backstage-plugin/plugins/scalprum-backend/package.json ./plugins/scalprum-backend/package.json
# Patches referenced in yarn.lock
COPY kuadrant-backstage-plugin/.yarn/patches/ ./.yarn/patches/
# Downstream .yarnrc.yml — adds multi-arch support and removes yarnPath (we use yarn 4 globally)
COPY .yarnrc.yml ./

# Install dependencies
RUN if [ -f /cachi2/cachi2.env ]; then source /cachi2/cachi2.env; fi && \
    yarn install

# Copy full submodule source (overwrites manifests — that's fine, they're identical)
COPY kuadrant-backstage-plugin/ ./
# Re-apply downstream .yarnrc.yml after submodule copy
COPY .yarnrc.yml ./

# Build only the kuadrant plugins (turbo resolves workspace deps automatically)
RUN if [ -f /cachi2/cachi2.env ]; then source /cachi2/cachi2.env; fi && \
    yarn turbo run build \
      --filter='./plugins/kuadrant' \
      --filter='./plugins/kuadrant-backend'

# Export as RHDH dynamic plugins (creates dist-dynamic/ in each plugin)
RUN if [ -f /cachi2/cachi2.env ]; then source /cachi2/cachi2.env; fi && \
    yarn workspace @kuadrant/kuadrant-backstage-plugin-frontend export-dynamic && \
    yarn workspace @kuadrant/kuadrant-backstage-plugin-backend export-dynamic

# Collect exported plugins
RUN mkdir -p /dynamic-plugins/dist && \
    cp -r plugins/kuadrant/dist-dynamic /dynamic-plugins/dist/kuadrant-backstage-plugin-frontend-dynamic && \
    cp -r plugins/kuadrant-backend/dist-dynamic /dynamic-plugins/dist/kuadrant-backstage-plugin-backend-dynamic

# Final image — minimal container with the exported plugin files
FROM registry.redhat.io/ubi9/ubi-micro:latest

COPY --from=builder /dynamic-plugins/dist/ /dynamic-plugins/dist/
COPY kuadrant-backstage-plugin/LICENSE /licenses/LICENSE

LABEL version="0.0.2-dev" \
      com.redhat.component="rhcl-rhdh-dynamic-plugin-container" \
      name="rhcl-1/rhcl-rhdh-dynamic-plugin-rhel9" \
      cpe="cpe:/a:redhat:connectivity_link:1::el9" \
      summary="Red Hat Connectivity Link RHDH Dynamic Plugins" \
      description="Backstage dynamic plugins for Red Hat Connectivity Link" \
      io.k8s.display-name="Red Hat Connectivity Link RHDH Dynamic Plugins" \
      io.openshift.tags="api" \
      io.k8s.description="" \
      maintainer="jmadigan@redhat.com"

USER 1001
